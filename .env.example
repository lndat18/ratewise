IMAP_HOST=
IMAP_PORT=
IMAP_USER=
IMAP_PASSWORD=DATABASE_URL=postgresql://user:pass@localhost:5432/falcon
# Thư mục lưu file đính kèm, phải nằm ngoài repo (mặc định ~/falcon_data)
DATA_DIR=
# Danh sách folder IMAP, phân cách bằng dấu phẩy (mặc định INBOX,Sent Items)
SYNC_FOLDERS=INBOX,Sent Items
SYNC_INTERVAL_SECONDS=300
